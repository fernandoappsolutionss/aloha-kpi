# ─────────────────────────────────────────────────────────────
# ALOHA KPI — Variables de entorno
# Copia este archivo como .env.local y rellena los valores.
# NUNCA subas .env.local al repositorio (ya está en .gitignore).
# ─────────────────────────────────────────────────────────────

# Cadena de conexión de Neon (Neon Dashboard → Connection Details).
# Usa la cadena "Pooled connection" (incluye "-pooler") para serverless.
DATABASE_URL="postgresql://usuario:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Secreto para firmar las cookies de sesión.
# Genera uno con:  openssl rand -base64 32
SESSION_SECRET="cambia-esto-por-una-cadena-larga-y-aleatoria"

# Secreto del cron diario de llenado (/api/cron/llenado). Vercel envía
# "Authorization: Bearer ${CRON_SECRET}" en cada corrida cuando la variable
# existe en el proyecto; sin ella el endpoint responde 401 SIEMPRE
# (fail-closed). Genera uno con:  openssl rand -base64 32
CRON_SECRET=""

# (Opcional) Credenciales del primer admin que crea  npm run db:seed
SEED_ADMIN_EMAIL="admin@aloha.com"
SEED_ADMIN_PASSWORD="aloha2026"
SEED_ADMIN_NOMBRE="Administrador General"

# ── Envío de correos (invitaciones y restablecimiento de contraseña) ──
# Opcional. Si NO configuras RESEND_API_KEY, la app sigue funcionando:
# al crear un usuario, el administrador copia el enlace de acceso y lo
# comparte manualmente (WhatsApp, etc.). Si la configuras, el enlace se
# envía además automáticamente por correo.
# Consigue la API key gratis en https://resend.com
RESEND_API_KEY=""
# Remitente verificado en Resend. Mientras no verifiques tu dominio,
# puedes usar el remitente de pruebas onboarding@resend.dev.
EMAIL_FROM="ALOHA KPI <onboarding@resend.dev>"

# URL pública de la app, usada para construir los enlaces de invitación.
# En Vercel normalmente se detecta sola; configúrala si usas un dominio propio.
APP_URL="https://aloha-kpi.vercel.app"

# ── Integración con el CRM de Team Solutionss (módulo Eventos) ──
# Permite que los centros creen eventos y gestionen registros/asistencia,
# sincronizados en vivo con el CRM. Si faltan, el módulo Eventos queda inactivo.
# CRM_API_URL = base del CRM (sin slash final). CRM_SERVICE_TOKEN debe ser el
# MISMO valor que ALOHA_SERVICE_TOKEN configurado en el CRM.
CRM_API_URL="https://agencia.teamsolutionss.com"
CRM_SERVICE_TOKEN=""

# ── Peticiones y cotizaciones: PDFs en Vercel Blob ──
# Token servidor del Blob Store PRIVADO conectado a este proyecto.
BLOB_READ_WRITE_TOKEN=""
# Solo desarrollo con túnel; permite que Vercel entregue onUploadCompleted.
VERCEL_BLOB_CALLBACK_URL=""
