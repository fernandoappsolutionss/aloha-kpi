# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.log

# env files (keep .env.example tracked)
.env
.env*.local

# vercel
.vercel
.claude/

# Reportes de corridas de scripts (dry-run/--apply): son evidencia local, no código
scripts/out/
# Andamiaje de medición (HTML generado para medir la hoja SOP en el navegador,
# capturas de trabajo): evidencia local de una auditoría, no código. Sin esto un
# `git add -A` se lleva cientos de KB de HTML generado al repo.
/.scratch/
/playwright-report/
/test-results/
/tests/e2e/.auth/
/artifacts/responsive-audit/

# Scripts sueltos de verificación contra la base (evidencia local, no código):
# abren producción y no deben viajar en un `git add -A`.
scratch-*.mjs
